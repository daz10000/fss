<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>fss</PackageId>
    <Description>Legacy lightweight F# HTTP server with a small Jinja2-style templating engine. For new projects prefer ASP.NET Core; the fss database wrappers (fss_duckdb, fss_postgres, fss_sqlite) do not depend on this package.</Description>
    <PackageTags>fsharp;webserver;http;jinja2;templates</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="json.fs" />
    <Compile Include="pool.fs" />
    <Compile Include="template.fs" />
    <Compile Include="sec.fs" />
    <Compile Include="multipart.fs" />
    <Compile Include="fss.fs" />
    <Compile Include="cookie.fs" />
  </ItemGroup>
</Project>
