<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>fss_duckdb</PackageId>
    <Description>Map DuckDB query results straight onto F# records, and insert F# records into DuckDB tables, with no mapping code. Works with in-memory or file databases and with DuckDB's ability to query CSV/Parquet/JSON files directly.</Description>
    <PackageTags>fsharp;duckdb;sql;orm;micro-orm;records;analytics</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\fss\pool.fs" Link="pool.fs" />
    <Compile Include="..\fss\db_common.fs" Link="db_common.fs" />
    <Compile Include="db_duckdb.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" />
  </ItemGroup>
</Project>
