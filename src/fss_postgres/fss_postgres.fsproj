<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>fss_postgres</PackageId>
    <Description>Map PostgreSQL query results straight onto F# records, and insert F# records into PostgreSQL tables, with no mapping code. Built on Npgsql.</Description>
    <PackageTags>fsharp;postgres;postgresql;npgsql;sql;orm;micro-orm;records</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\fss\pool.fs" Link="pool.fs" />
    <Compile Include="..\fss\db_common.fs" Link="db_common.fs" />
    <Compile Include="db_pg.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>
</Project>
