<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>fss_sqlite</PackageId>
    <Description>Map SQLite query results straight onto F# records, and insert F# records into SQLite tables, with no mapping code. Built on Microsoft.Data.Sqlite.</Description>
    <PackageTags>fsharp;sqlite;sql;orm;micro-orm;records</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\fss\pool.fs" Link="pool.fs" />
    <Compile Include="..\fss\db_common.fs" Link="db_common.fs" />
    <Compile Include="db_sqlite.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
</Project>
